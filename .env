spring.application.name=healthcheck-monitor
server.port=8080

spring.datasource.url=jdbc:sqlite:healthcheck.db
spring.datasource.driver-class-name=org.sqlite.JDBC
spring.jpa.database-platform=org.hibernate.community.dialect.SQLiteDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

#  Initialisation automatique de la base de données
spring.sql.init.mode=always
spring.sql.init.platform=sqlite
spring.sql.init.schema-locations=classpath:db/init.sql

jwt.secret=/GRDnJrlgSetefC9cTfLXcUol9J6DCcxCAFPgRif1J0=
jwt.expiration=86400000

cors.allowed-origins=http://localhost:3000

logging.level.com.healthcheck=DEBUG
logging.file.name=logs/healthcheck.log

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=erramireda157@gmail.com
spring.mail.password=cuqhexwedrovgkbf
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

scheduler.pool.size=10
scheduler.initial-delay=5000

management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always

springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html